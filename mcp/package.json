    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.3",
